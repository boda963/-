{
  "name": "MiroFish - Free Codespaces Launcher",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "bash scripts/setup.sh",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "MiroFish private UI",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "5001": {
      "label": "MiroFish API local only",
      "onAutoForward": "ignore",
      "visibility": "private"
    }
  }
}
